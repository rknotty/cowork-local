{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Output file name ending in .docx, inside the session workspace."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 150 },
    "subtitle": { "type": "string", "maxLength": 200 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "description": "Document content in order. Each block has a type.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["heading", "paragraph", "bullet_list", "numbered_list", "table"]
          },
          "level": { "type": "integer", "minimum": 1, "maximum": 3 },
          "text": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" }, "maxItems": 30 },
          "headers": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
          "rows": {
            "type": "array",
            "maxItems": 60,
            "items": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
          }
        },
        "required": ["type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["path", "title", "blocks"],
  "additionalProperties": false
}
