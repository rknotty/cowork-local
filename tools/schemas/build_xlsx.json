{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Output file name ending in .xlsx, inside the session workspace."
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 31 },
          "headers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 26,
            "items": { "type": "string" }
          },
          "rows": {
            "type": "array",
            "maxItems": 2000,
            "description": "Row values in header order. A string starting with = is a formula, such as =SUM(B2:B9).",
            "items": {
              "type": "array",
              "maxItems": 26,
              "items": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        },
        "required": ["name", "headers", "rows"],
        "additionalProperties": false
      }
    }
  },
  "required": ["path", "sheets"],
  "additionalProperties": false
}
