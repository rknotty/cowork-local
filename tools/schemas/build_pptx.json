{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Output file name ending in .pptx, inside the session workspace."
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "description": "Slides in order. Each slide names one of the eight layouts.",
      "items": {
        "type": "object",
        "properties": {
          "layout": {
            "type": "string",
            "enum": [
              "title",
              "section",
              "bullets",
              "two_column",
              "quote",
              "table",
              "big_number",
              "closing"
            ]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "subtitle": { "type": "string", "maxLength": 140 },
          "bullets": {
            "type": "array",
            "items": { "type": "string", "maxLength": 140 },
            "maxItems": 6
          },
          "left_bullets": {
            "type": "array",
            "items": { "type": "string", "maxLength": 100 },
            "maxItems": 5
          },
          "right_bullets": {
            "type": "array",
            "items": { "type": "string", "maxLength": 100 },
            "maxItems": 5
          },
          "quote": { "type": "string", "maxLength": 240 },
          "attribution": { "type": "string", "maxLength": 80 },
          "number": { "type": "string", "maxLength": 12 },
          "caption": { "type": "string", "maxLength": 140 },
          "headers": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
          "rows": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "array", "items": { "type": "string" }, "maxItems": 6 }
          },
          "notes": { "type": "string", "maxLength": 1500 }
        },
        "required": ["layout", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": ["path", "slides"],
  "additionalProperties": false
}
